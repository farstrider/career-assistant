# Non-secret local deployment template. Copy to the untracked .env and replace values.
CAREER_APP_ENVIRONMENT=development
CAREER_APP_TIMEZONE=Asia/Tokyo
CAREER_APP_BIND_ADDRESS=192.168.1.20
CAREER_APP_PORT=8443
CAREER_APP_BASE_URL=https://192.168.1.20:8443
CAREER_TLS_CERT_FILE=/absolute/path/to/career-assistant.crt
CAREER_TLS_PRIVATE_KEY_FILE=/absolute/path/to/career-assistant.key

# For running the API directly, place credentials in an untracked .env or *_FILE path.
CAREER_DATABASE_URL_FILE=/run/secrets/career_database_url
CAREER_REDIS_URL=redis://127.0.0.1:6379/0
CAREER_SECURITY_ARTIFACT_KEY_FILE=/absolute/path/to/artifact-fernet.key

# The endpoint is the full chat-completions URL.
# Keep the key in the worker-only environment; do not commit it or expose it to the API.
CAREER_LLM_ENDPOINT=
CAREER_LLM_MODEL=
CAREER_LLM_API_KEY=
CAREER_LLM_TIMEOUT_SECONDS=30
CAREER_LLM_MAX_TOKENS=1200
CAREER_LLM_DAILY_TOKEN_BUDGET=100000
CAREER_LLM_TASK_TOKEN_BUDGET=20000

# Optional compose.mail.yaml inputs. The app password must be an untracked mode-0600 file.
GMAIL_USERNAME=career-alerts@example.com
GMAIL_MAILBOX=Career Alerts
GMAIL_APP_PASSWORD_FILE=/absolute/path/to/gmail-app-password
